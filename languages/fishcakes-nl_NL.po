msgstr "Marketing & social media — label"

#: includes/class-fc-admin.php:280
msgid "Marketing & social media — description"
msgstr "Marketing & social media — omschrijving"

#: includes/class-fc-admin.php:301
msgid "Banner title"
msgstr "Bannertitel"

#: includes/class-fc-admin.php:302
msgid "Banner intro"
msgstr "Introtekst banner"

#: includes/class-fc-admin.php:303
msgid "Privacy link text"
msgstr "Tekst privacylink"

#: includes/class-fc-admin.php:304
msgid "Button: accept all"
msgstr "Knop: alles accepteren"

#: includes/class-fc-admin.php:305
msgid "Button: reject all"
msgstr "Knop: alles weigeren"

#: includes/class-fc-admin.php:306
msgid "Button: save choices"
msgstr "Knop: keuzes opslaan"

#: includes/class-fc-admin.php:307
msgid "Button: change choices"
msgstr "Knop: keuzes aanpassen"

#: includes/class-fc-admin.php:308
msgid "Confirmation message"
msgstr "Bevestigingsmelding"

#: includes/class-fc-admin.php:309
msgid "Footer link text"
msgstr "Tekst footerlink"

#: includes/class-fc-admin.php:331
msgid "Registered scripts"
msgstr "Geregistreerde scripts"

#: includes/class-fc-admin.php:346
msgid "Block embeds"
msgstr "Embeds blokkeren"

#: includes/class-fc-admin.php:347
msgid "Replace embeds that may place tracking cookies with a placeholder until marketing consent is given. Covers the block editor, classic editor, raw iframes, ACF oEmbed and ACF WYSIWYG fields."
msgstr "Vervang embeds die trackingcookies kunnen plaatsen door een placeholder totdat er toestemming is voor marketingcookies. Werkt voor de blokeditor, de klassieke editor, losse iframes en ACF oEmbed- en WYSIWYG-velden."

#: includes/class-fc-admin.php:354
msgid "Providers"
msgstr "Aanbieders"

#: includes/class-fc-admin.php:362
msgid "Custom hosts"
msgstr "Eigen hosts"

#: includes/class-fc-admin.php:369
msgid "Placeholder button"
msgstr "Knop in placeholder"

#: includes/class-fc-admin.php:370
msgid "Placeholder text: no choice yet"
msgstr "Placeholdertekst: nog geen keuze"

#: includes/class-fc-admin.php:371
msgid "Placeholder text: not allowed"
msgstr "Placeholdertekst: niet toegestaan"

#: includes/class-fc-admin.php:400
msgid "Enabled"
msgstr "Ingeschakeld"

#: includes/class-fc-admin.php:472
msgid "Leave empty to use the default (translated) text."
msgstr "Laat leeg om de standaard (vertaalde) tekst te gebruiken."

#: includes/class-fc-admin.php:475
msgid "Leave empty to use the default text. Use {privacy_link} to insert a link to your privacy page. Basic HTML allowed."
msgstr "Laat leeg om de standaardtekst te gebruiken. Gebruik {privacy_link} om een link naar je privacypagina in te voegen. Eenvoudige HTML is toegestaan."

#. translators: %s: default class names.
#: includes/class-fc-admin.php:502
#, php-format
msgid "Added next to the plugin’s own classes. Separate multiple classes with a space; leave empty to add none. Default: %s"
msgstr "Wordt toegevoegd naast de eigen classes van de plugin. Scheid meerdere classes met een spatie; laat leeg om niets toe te voegen. Standaard: %s"

#: includes/class-fc-admin.php:536
msgid "— Select a page —"
msgstr "— Selecteer een pagina —"

#: includes/class-fc-admin.php:542
msgid "Linked from the banner intro via the {privacy_link} token."
msgstr "Gelinkt vanuit de introtekst van de banner via de {privacy_link}-code."

#. translators: Embed provider name.
#: includes/class-fc-admin.php:554
#: includes/class-fc-settings.php:233
msgid "YouTube"
msgstr "YouTube"

#. translators: Embed provider name.
#: includes/class-fc-admin.php:555
#: includes/class-fc-settings.php:238
msgid "Vimeo"
msgstr "Vimeo"

#. translators: Embed provider name.
#: includes/class-fc-admin.php:556
#: includes/class-fc-settings.php:243
msgid "Spotify"
msgstr "Spotify"

#. translators: Embed provider name.
#: includes/class-fc-admin.php:557
#: includes/class-fc-settings.php:248
msgid "SoundCloud"
msgstr "SoundCloud"

#: includes/class-fc-admin.php:558
msgid "Google (Maps, Docs, Calendar)"
msgstr "Google (Maps, Docs, Agenda)"

#: includes/class-fc-admin.php:562
msgid "Blocked embed providers"
msgstr "Geblokkeerde embed-aanbieders"

#: includes/class-fc-admin.php:569
msgid "Hosts and all their subdomains are matched against embed URLs and iframe sources."
msgstr "Hosts en al hun subdomeinen worden vergeleken met embed-URL's en iframe-bronnen."

#: includes/class-fc-admin.php:582
msgid "One hostname per line, optionally followed by | and a display name. Blocks embeds from these hosts and their subdomains."
msgstr "Eén hostnaam per regel, eventueel gevolgd door | en een weergavenaam. Blokkeert embeds van deze hosts en hun subdomeinen."

#: includes/class-fc-admin.php:609
msgid "Scripts are printed as inert placeholders and only execute after the visitor consents to their category. The choice is applied without a page reload."
msgstr "Scripts worden als inactieve placeholders geplaatst en pas uitgevoerd nadat de bezoeker toestemming geeft voor hun categorie. De keuze wordt toegepast zonder de pagina te herladen."

#: includes/class-fc-admin.php:622
msgid "Add script"
msgstr "Script toevoegen"

#: includes/class-fc-admin.php:627
msgid "Inline code: paste the snippet, with or without the surrounding <script> tags. Source URL: load an external script file."
msgstr "Inline code: plak de snippet, met of zonder de omringende <script>-tags. Bron-URL: laad een extern scriptbestand."

#: includes/class-fc-admin.php:660
msgid "Script enabled"
msgstr "Script ingeschakeld"

#: includes/class-fc-admin.php:662
msgid "Name (for example: Google Analytics 4)"
msgstr "Naam (bijvoorbeeld: Google Analytics 4)"

#: includes/class-fc-admin.php:664
#: includes/class-fc-settings.php:179
msgid "Analytical"
msgstr "Analytisch"

#: includes/class-fc-admin.php:665
msgid "Marketing"
msgstr "Marketing"

#: includes/class-fc-admin.php:668
msgid "Head"
msgstr "Head"

#: includes/class-fc-admin.php:669
msgid "Footer"
msgstr "Footer"

#: includes/class-fc-admin.php:672
msgid "Inline code"
msgstr "Inline code"

#: includes/class-fc-admin.php:673
msgid "Source URL"
msgstr "Bron-URL"

#: includes/class-fc-admin.php:675
msgid "Remove this script"
msgstr "Dit script verwijderen"

#: includes/class-fc-admin.php:679
msgid "Paste the snippet here — with or without the surrounding <script> tags."
msgstr "Plak de snippet hier — met of zonder de omringende <script>-tags."

#. translators: 1: required WordPress version, 2: required PHP version.
#: includes/class-fc-plugin.php:80
#, php-format
msgid "FishCakes requires WordPress %1$s or higher and PHP %2$s or higher. The plugin is not active on this site."
msgstr "FishCakes vereist WordPress %1$s of hoger en PHP %2$s of hoger. De plugin is niet actief op deze site."

#: includes/class-fc-settings.php:165
msgid "Cookies"
msgstr "Cookies"

#: includes/class-fc-settings.php:166
msgid "We use cookies and similar technologies on this website. Choose which cookies we may place. You can change your choice at any time. See our {privacy_link} for more information."
msgstr "Wij gebruiken cookies en vergelijkbare technieken op deze website. Kies welke cookies we mogen plaatsen. Je kunt je keuze altijd weer aanpassen. Lees ons {privacy_link} voor meer informatie."

#: includes/class-fc-settings.php:167
msgid "privacy policy"
msgstr "privacybeleid"

#: includes/class-fc-settings.php:168
msgid "Accept all cookies"
msgstr "Alle cookies accepteren"

#: includes/class-fc-settings.php:169
msgid "Reject all cookies"
msgstr "Alle cookies weigeren"

#: includes/class-fc-settings.php:170
msgid "Save choices"
msgstr "Keuzes opslaan"

#: includes/class-fc-settings.php:171
msgid "Change choices"
msgstr "Keuzes aanpassen"

#: includes/class-fc-settings.php:172
msgid "Your cookie preferences have been saved."
msgstr "Je cookievoorkeuren zijn opgeslagen."

#: includes/class-fc-settings.php:173
#: includes/class-fc-settings.php:174
msgid "Cookie settings"
msgstr "Cookie-instellingen"

#: includes/class-fc-settings.php:175
msgid "You have not made a choice about cookies yet, so we cannot show this content. It may be placed by a third party that could follow you across websites."
msgstr "Je hebt nog geen keuze gemaakt over cookies, daarom kunnen we deze inhoud niet tonen. De inhoud wordt mogelijk geplaatst door een derde partij die je over verschillende websites kan volgen."

#: includes/class-fc-settings.php:176
msgid "Your cookie preferences do not allow this content, because it may be placed by a third party that could follow you across websites."
msgstr "Je cookievoorkeuren staan deze inhoud niet toe, omdat die mogelijk wordt geplaatst door een derde partij die je over verschillende websites kan volgen."

#: includes/class-fc-settings.php:177
msgid "Necessary"
msgstr "Noodzakelijk"

#: includes/class-fc-settings.php:178
msgid "Necessary cookies are needed for this website to work — for example, to remember your cookie choices. These cannot be switched off."
msgstr "Noodzakelijke cookies zijn nodig om deze website te laten werken — bijvoorbeeld om je cookiekeuze te onthouden. Deze kunnen niet worden uitgeschakeld."

#: includes/class-fc-settings.php:180
msgid "Analytical cookies measure how this website is used — for example which pages are visited and for how long. We use this data to improve the website."
msgstr "Analytische cookies meten hoe deze website wordt gebruikt — bijvoorbeeld welke pagina's worden bezocht en hoe lang. Met deze gegevens verbeteren we de website."

#: includes/class-fc-settings.php:181
msgid "Marketing & social media"
msgstr "Marketing & social media"

#: includes/class-fc-settings.php:182
msgid "Marketing and social media cookies are placed by third parties — such as YouTube, Vimeo and Spotify — to show embedded content and to tailor advertisements to your interests."
msgstr "Marketing- en socialmediacookies worden geplaatst door derde partijen — zoals YouTube, Vimeo en Spotify — om ingesloten inhoud te tonen en advertenties af te stemmen op je interesses."

#. translators: Embed provider name.
#: includes/class-fc-settings.php:253
msgid "Google Maps"
msgstr "Google Maps"

#. translators: %d: number of script rows.
#: includes/class-fc-settings.php:557
#, php-format
msgid "FishCakes: %d script was not saved because it was empty or its URL was invalid."
msgid_plural "FishCakes: %d scripts were not saved because they were empty or their URLs were invalid."
msgstr[0] "FishCakes: %d script is niet opgeslagen omdat het leeg was of de URL ongeldig was."
msgstr[1] "FishCakes: %d scripts zijn niet opgeslagen omdat ze leeg waren of de URL ongeldig was."
