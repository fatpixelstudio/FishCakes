msgid "Cookie consent"
msgstr "Cookietoestemming"

#: includes/class-fc-admin.php:63
msgctxt "admin menu label"
msgid "Cookie consent"
msgstr "Cookie&shy;toestemming"

#: includes/class-fc-admin.php:103
msgid "General"
msgstr "Algemeen"

#: includes/class-fc-admin.php:104
msgid "Appearance"
msgstr "Weergave"

#: includes/class-fc-admin.php:105
