msgid "Google (Maps, Docs, Calendar)"
msgstr "Google (Maps, Docs, Agenda)"

#: includes/class-fc-admin.php:576
msgid "Blocked embed providers"
msgstr "Geblokkeerde embed-aanbieders"

#: includes/class-fc-admin.php:583
msgid "Hosts and all their subdomains are matched against embed URLs and iframe sources."
msgstr "Hosts en al hun subdomeinen worden vergeleken met embed-URL's en iframe-bronnen."

#: includes/class-fc-admin.php:596
msgid "One hostname per line, optionally followed by | and a display name. Blocks embeds from these hosts and their subdomains."
msgstr "Eén hostnaam per regel, eventueel gevolgd door | en een weergavenaam. Blokkeert embeds van deze hosts en hun subdomeinen."

#: includes/class-fc-admin.php:623
msgid "Scripts are printed as inert placeholders and only execute after the visitor consents to their category. The choice is applied without a page reload."
msgstr "Scripts worden als inactieve placeholders geplaatst en pas uitgevoerd nadat de bezoeker toestemming geeft voor hun categorie. De keuze wordt toegepast zonder de pagina te herladen."

#: includes/class-fc-admin.php:636
msgid "Add script"
msgstr "Script toevoegen"

#: includes/class-fc-admin.php:641
msgid "Inline code: paste the snippet, with or without the surrounding <script> tags. Source URL: load an external script file."
msgstr "Inline code: plak de snippet, met of zonder de omringende <script>-tags. Bron-URL: laad een extern scriptbestand."

#: includes/class-fc-admin.php:674
msgid "Script enabled"
msgstr "Script ingeschakeld"

#: includes/class-fc-admin.php:676
