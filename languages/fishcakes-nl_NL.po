#: includes/class-fc-admin.php:315
msgid "Banner title"
msgstr "Bannertitel"

#: includes/class-fc-admin.php:316
msgid "Banner intro"
msgstr "Introtekst banner"

#: includes/class-fc-admin.php:317
msgid "Privacy link text"
msgstr "Tekst privacylink"

#: includes/class-fc-admin.php:318
msgid "Button: accept all"
msgstr "Knop: alles accepteren"

#: includes/class-fc-admin.php:319
msgid "Button: reject all"
msgstr "Knop: alles weigeren"

#: includes/class-fc-admin.php:320
msgid "Button: save choices"
msgstr "Knop: keuzes opslaan"

#: includes/class-fc-admin.php:321
msgid "Button: change choices"
msgstr "Knop: keuzes aanpassen"

#: includes/class-fc-admin.php:322
msgid "Confirmation message"
msgstr "Bevestigingsmelding"

#: includes/class-fc-admin.php:323
msgid "Footer link text"
msgstr "Tekst footerlink"

#: includes/class-fc-admin.php:345
msgid "Registered scripts"
msgstr "Geregistreerde scripts"

#: includes/class-fc-admin.php:360
msgid "Block embeds"
msgstr "Embeds blokkeren"

#: includes/class-fc-admin.php:361
msgid "Replace embeds that may place tracking cookies with a placeholder until marketing consent is given. Covers the block editor, classic editor, raw iframes, ACF oEmbed and ACF WYSIWYG fields."
msgstr "Vervang embeds die trackingcookies kunnen plaatsen door een placeholder totdat er toestemming is voor marketingcookies. Werkt voor de blokeditor, de klassieke editor, losse iframes en ACF oEmbed- en WYSIWYG-velden."

#: includes/class-fc-admin.php:368
msgid "Providers"
msgstr "Aanbieders"

#: includes/class-fc-admin.php:376
msgid "Custom hosts"
msgstr "Eigen hosts"

#: includes/class-fc-admin.php:383
msgid "Placeholder button"
msgstr "Knop in placeholder"

#: includes/class-fc-admin.php:384
msgid "Placeholder text: no choice yet"
msgstr "Placeholdertekst: nog geen keuze"

#: includes/class-fc-admin.php:385
msgid "Placeholder text: not allowed"
msgstr "Placeholdertekst: niet toegestaan"

#: includes/class-fc-admin.php:414
msgid "Enabled"
msgstr "Ingeschakeld"

#: includes/class-fc-admin.php:486
msgid "Leave empty to use the default (translated) text."
msgstr "Laat leeg om de standaard (vertaalde) tekst te gebruiken."

#: includes/class-fc-admin.php:489
msgid "Leave empty to use the default text. Use {privacy_link} to insert a link to your privacy page. Basic HTML allowed."
msgstr "Laat leeg om de standaardtekst te gebruiken. Gebruik {privacy_link} om een link naar je privacypagina in te voegen. Eenvoudige HTML is toegestaan."

#. translators: %s: default class names.
#: includes/class-fc-admin.php:516
#, php-format
msgid "Added next to the plugin’s own classes. Separate multiple classes with a space; leave empty to add none. Default: %s"
msgstr "Wordt toegevoegd naast de eigen classes van de plugin. Scheid meerdere classes met een spatie; laat leeg om niets toe te voegen. Standaard: %s"

#: includes/class-fc-admin.php:550
msgid "— Select a page —"
msgstr "— Selecteer een pagina —"

#: includes/class-fc-admin.php:556
msgid "Linked from the banner intro via the {privacy_link} token."
msgstr "Gelinkt vanuit de introtekst van de banner via de {privacy_link}-code."

