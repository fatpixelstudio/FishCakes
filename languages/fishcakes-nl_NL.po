#. Plugin Name of the plugin
#: fishcakes.php
#: includes/class-fc-admin.php:57
msgid "FishCakes"
msgstr "FishCakes"

#. Plugin URI of the plugin
#: fishcakes.php
msgid "https://github.com/fatpixelstudio/FishCakes"
msgstr "https://github.com/fatpixelstudio/FishCakes"

#. Description of the plugin
#: fishcakes.php
msgid "GDPR/AVG-proof, accessible cookie consent for WordPress: consent banner, gated scripts and blocked embeds."
msgstr "AVG-proof, toegankelijke cookietoestemming voor WordPress: toestemmingsbanner, afgeschermde scripts en geblokkeerde embeds."

#. Author of the plugin
#: fishcakes.php
msgid "Fat Pixel Studio"
msgstr "Fat Pixel Studio"

#. Author URI of the plugin
#: fishcakes.php
msgid "https://fatpixel.studio"
msgstr "https://fatpixel.studio"

#: includes/class-fc-admin.php:56
msgid "FishCakes cookie consent"
msgstr "FishCakes cookietoestemming"

#: includes/class-fc-admin.php:97
msgid "General"
msgstr "Algemeen"

#: includes/class-fc-admin.php:98
msgid "Appearance"
msgstr "Weergave"

#: includes/class-fc-admin.php:99
msgid "Theme classes"
msgstr "Themeklassen"

#: includes/class-fc-admin.php:100
msgid "Cookie categories"
msgstr "Cookiecategorieën"

#: includes/class-fc-admin.php:101
msgid "Banner texts"
msgstr "Bannerteksten"

#: includes/class-fc-admin.php:102
msgid "Scripts"
msgstr "Scripts"

#: includes/class-fc-admin.php:103
msgid "Blocked embeds"
msgstr "Geblokkeerde embeds"

#: includes/class-fc-admin.php:155
msgid "Enable"
msgstr "Inschakelen"

#: includes/class-fc-admin.php:156
msgid "Show the consent banner, gate registered scripts and block embeds."
msgstr "Toon de toestemmingsbanner, scherm geregistreerde scripts af en blokkeer embeds."

#: includes/class-fc-admin.php:163
msgid "Banner position"
msgstr "Positie van de banner"

#: includes/class-fc-admin.php:164
msgid "Bottom (recommended)"
msgstr "Onderaan (aanbevolen)"

#: includes/class-fc-admin.php:164
msgid "Top"
msgstr "Bovenaan"

#: includes/class-fc-admin.php:171
msgid "Consent expiry (days)"
msgstr "Geldigheid toestemming (dagen)"

#: includes/class-fc-admin.php:172
msgid "How long a consent stays valid. After it expires, the banner returns. Max 365."
msgstr "Hoe lang een toestemming geldig blijft. Daarna verschijnt de banner opnieuw. Maximaal 365."

#: includes/class-fc-admin.php:179
msgid "Banner version"
msgstr "Bannerversie"

#: includes/class-fc-admin.php:180
msgid "Increase this number to ask every visitor for consent again, for example after changing the texts or your cookie policy."
msgstr "Verhoog dit getal om elke bezoeker opnieuw om toestemming te vragen, bijvoorbeeld na het aanpassen van de teksten of je cookiebeleid."

#: includes/class-fc-admin.php:187
msgid "Privacy page"
msgstr "Privacypagina"

#: includes/class-fc-admin.php:195
msgid "Footer link"
msgstr "Footerlink"

#: includes/class-fc-admin.php:196
msgid "Automatically add a “Cookie settings” button to the footer, so consent can always be withdrawn."
msgstr "Voeg automatisch een knop “Cookie-instellingen” toe aan de footer, zodat toestemming altijd kan worden ingetrokken."

#: includes/class-fc-admin.php:203
msgid "Cache-safe mode"
msgstr "Cacheveilige modus"

#: includes/class-fc-admin.php:204
msgid "For sites with a full-page cache that ignores cookies. Embeds are always rendered as placeholders and upgraded in the browser, so cached pages can never show embeds to visitors who did not consent."
msgstr "Voor sites met een full-page cache die cookies negeert. Embeds worden altijd als placeholder weergegeven en pas in de browser geladen, zodat gecachte pagina's nooit embeds tonen aan bezoekers die geen toestemming gaven."

#: includes/class-fc-admin.php:217
msgid "Background"
msgstr "Achtergrond"

#: includes/class-fc-admin.php:218
msgid "Text"
msgstr "Tekst"

#: includes/class-fc-admin.php:219
