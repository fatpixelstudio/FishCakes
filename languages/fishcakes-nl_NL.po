#. Plugin Name of the plugin
#: fishcakes.php
msgid "FishCakes"
msgstr "FishCakes"

#. Plugin URI of the plugin
#: fishcakes.php
msgid "https://github.com/fatpixelstudio/FishCakes"
msgstr "https://github.com/fatpixelstudio/FishCakes"

#. Description of the plugin
#: fishcakes.php
msgid "GDPR/AVG-proof, accessible cookie consent for WordPress: consent banner, gated scripts and blocked embeds."
msgstr "AVG-proof, toegankelijke cookietoestemming voor WordPress: toestemmingsbanner, afgeschermde scripts en geblokkeerde embeds."

#. Author of the plugin
#: fishcakes.php
msgid "Fat Pixel Studio"
msgstr "Fat Pixel Studio"

#. Author URI of the plugin
#: fishcakes.php
msgid "https://fatpixel.studio"
msgstr "https://fatpixel.studio"

